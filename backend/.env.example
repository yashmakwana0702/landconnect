# Copy to backend/.env and fill in.

# Local Postgres from docker-compose (the api container overrides this with the db host).
DATABASE_URL=postgresql+asyncpg://landconnect:landconnect@localhost:5432/landconnect

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# LiveKit: LiveKit Cloud (free tier) is easiest for real phones.
# Project settings -> Keys: URL looks like wss://<project>.livekit.cloud
# For the local dev server (docker compose --profile livekit): ws://<LAN-IP>:7880, devkey / secret
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-key
LIVEKIT_API_SECRET=your-secret

# Seconds before an unanswered call becomes "missed".
CALL_RING_TIMEOUT_S=35

# Optional: enables Claude-based parsing for AI matching (falls back to rules if unset).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
